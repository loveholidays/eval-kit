{
  "name": "@loveholidays/eval-kit",
  "version": "1.2.0",
  "description": "TypeScript SDK for content evaluation",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loveholidays/eval-kit.git"
  },
  "bugs": {
    "url": "https://github.com/loveholidays/eval-kit/issues"
  },
  "homepage": "https://github.com/loveholidays/eval-kit#readme",
  "keywords": [
    "evaluation",
    "content",
    "sdk",
    "typescript",
    "llm",
    "ai",
    "metrics",
    "bleu",
    "bert-score"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "packageManager": "pnpm@10.20.0",
  "files": [
    "dist"
  ],
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.6",
      "@isaacs/brace-expansion": "^5.0.8",
      "@opentelemetry/core": "^2.8.0",
      "@opentelemetry/propagator-jaeger": "^2.9.0",
      "ajv": "^8.18.0",
      "brace-expansion": "^5.0.8",
      "diff": ">=8.0.3",
      "handlebars": "^4.7.9",
      "js-yaml@3.14.2": "^3.15.0",
      "js-yaml@4.1.1": "^4.3.0",
      "lodash": ">=4.18.0",
      "minimatch@3.1.2": "^3.1.4",
      "minimatch@9.0.5": "^9.0.7",
      "minimatch@10.0.3": "^10.2.3",
      "picomatch@2.3.1": "^2.3.2",
      "picomatch@4.0.3": "^4.0.4",
      "postcss": "^8.5.18",
      "protobufjs": "^7.5.5",
      "rollup": "^4.59.0",
      "sharp": "^0.35.0"
    }
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@changesets/cli": "^2.29.8",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "ai": "^6.0.175",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "fastest-levenshtein": "^1.0.16",
    "zod": "^3.23.8"
  }
}
